{
  "name": "medical-record-api",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "test": "docker compose exec -T app npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "docker compose exec -T app npm run test:unit:coverage",
    "test:unit:coverage": "vitest run --coverage",
    "check": "tsc --noEmit && prettier . --check && eslint",
    "fix": "prettier . --write && eslint . --fix",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d ./src/shared/infra/typeorm/index.ts",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/shared/infra/typeorm/index.js",
    "seed:run": "tsx ./src/shared/infra/typeorm/seed/index.ts",
    "seed:run:prod": "node ./dist/shared/infra/typeorm/seed/index.js",
    "dev": "tsx watch ./src/shared/infra/http/server.ts",
    "start": "node ./dist/shared/infra/http/server.js",
    "build": "tsc && tsc-alias"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "celebrate": "^15.0.1",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.2.0",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.6.0",
    "typeorm": "^0.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "lodash": "^4.17.21"
  }
}
